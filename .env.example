# ---- Database ----
# Local dev (docker-compose): postgresql://papex:papex@localhost:5432/papex
# Vercel/Neon: use the POOLED connection string here for app runtime.
# For migrations (drizzle-kit) use the direct (unpooled) string in DATABASE_URL_UNPOOLED.
DATABASE_URL="postgresql://papex:papex@localhost:5432/papex"
DATABASE_URL_UNPOOLED="postgresql://papex:papex@localhost:5432/papex"

# ---- Auth ----
# 32+ char random secret for JWT signing (jose). Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
# Session cookie lifetime in seconds (default 7 days)
AUTH_SESSION_TTL="604800"

# ---- App ----
NEXT_PUBLIC_APP_NAME="Papex"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- PDF storage (choose a backend) ----
# Driver: "local" (server-managed filesystem, default) | "s3" (S3-compatible object storage)
# STORAGE_DRIVER="local"
#
# local backend:
# PAPEX_STORAGE_DIR="./storage"
#
# s3 backend (AWS S3 / MinIO / Cloudflare R2 / DigitalOcean Spaces):
# PAPEX_S3_BUCKET="papex-pdfs"
# PAPEX_S3_REGION="auto"                  # us-east-1 for AWS; "auto" for Cloudflare R2
# PAPEX_S3_ENDPOINT="https://s3.amazonaws.com"   # S3-compatible endpoint (required for R2/MinIO/Spaces)
# PAPEX_S3_ACCESS_KEY_ID=""
# PAPEX_S3_SECRET_ACCESS_KEY=""
# PAPEX_S3_FORCE_PATH_STYLE="true"        # true for MinIO/R2/Spaces; false for AWS virtual-hosted
# PAPEX_S3_PUBLIC_BASE=""                 # optional: public bucket/CDN base URL -> skip signing (e.g. https://cdn.example.com)

# ---- Optional: email notifications (Resend or SMTP) ----
# EMAIL_PROVIDER="resend"   # resend | smtp | (unset = skip emails)
# RESEND_API_KEY="re_xxx"
# RESEND_FROM="onboarding@resend.dev"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="noreply@papex.dev"
