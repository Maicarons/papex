# ---- Database ----
# Local dev (docker-compose): postgresql://papex:papex@localhost:5432/papex
# Vercel/Neon: use the POOLED connection string here for app runtime.
# For migrations (drizzle-kit) use the direct (unpooled) string in DATABASE_URL_UNPOOLED.
DATABASE_URL="postgresql://papex:papex@localhost:5432/papex"
DATABASE_URL_UNPOOLED="postgresql://papex:papex@localhost:5432/papex"

# ---- Auth ----
# 32+ char random secret for JWT signing (jose). Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
# Session cookie lifetime in seconds (default 7 days)
AUTH_SESSION_TTL="604800"

# ---- App ----
NEXT_PUBLIC_APP_NAME="Papex"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Optional: file storage for PDFs ----
# PAPEX_STORAGE_DIR="./storage"
# STORAGE_DRIVER="local"   # local | blob (Vercel Blob for production)

# ---- Optional: email notifications (Resend or SMTP) ----
# EMAIL_PROVIDER="resend"   # resend | smtp | (unset = skip emails)
# RESEND_API_KEY="re_xxx"
# RESEND_FROM="onboarding@resend.dev"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="noreply@papex.dev"
